{
  "name": "dynasty-front-office",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/generate-sitemap.mjs && vite build && npm run validate:seo",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc -b --noEmit",
    "compute-ratings": "node scripts/refresh-current-rosters.mjs",
    "validate:core": "node scripts/validate-core-loop.mjs",
    "validate:draft-trades": "node scripts/validate-draft-pick-trades.mjs",
    "validate:cba": "node scripts/validate-cba-rules.mjs",
    "deploy": "npm run build && wrangler deploy",
    "sync:rosters": "node scripts/refresh-current-rosters.mjs",
    "validate:rosters": "node scripts/validate-roster-snapshot.mjs",
    "validate:simulation": "node scripts/validate-dashboard-simulation.mjs",
    "validate:seo": "node scripts/validate-public-seo.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.16.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.25.12",
    "playwright": "^1.60.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.98.0"
  }
}
